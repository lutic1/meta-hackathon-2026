# Copy to .env and fill in what you have. Every key is blank here; a blank
# value means "use the default" (AD-14). MODEL_PROVIDER=mock needs no keys.
# Containers and CI never hold key values.

# Product flags. Defaults: CACHE=on, SPEND_CAP_USD=60 (Local allocation),
# DEMO_TIMESCALE=1, DEMO_TRICKSTER=live|record|scripted|authored,
# DRY_RUN=on, REGEN_MAX=2, GUIDE=ollama|verbatim.
CACHE=
SPEND_CAP_USD=
DEMO_TIMESCALE=
DEMO_TRICKSTER=
DRY_RUN=
REGEN_MAX=
GUIDE=

# Adapters: mock or meta (default meta); openai_compatible, fal and ollama
# arrive with their stories. MODEL_PROVIDER is the default for each role.
MODEL_PROVIDER=
PROVIDER_ARCHITECT=
PROVIDER_RIDDLER=
PROVIDER_DRYRUN=
PROVIDER_TRICKSTER=
PROVIDER_IMAGE=

# Per-role model ids. Defaults: muse-spark-1.3 for the council roles,
# muse-image-1.0 for the image role.
MODEL_ARCHITECT=
MODEL_RIDDLER=
MODEL_DRYRUN=
MODEL_TRICKSTER=
MODEL_IMAGE=

# Meta Model API (standard tier only). Base URL default: https://api.meta.ai/v1
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=

# OpenAI-compatible fallback hosts (Baseten, Fireworks).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# fal.ai (SAM 3D Objects, Tier 2).
FAL_KEY=

# Ollama Guide on the Mac. Default: the local server.
OLLAMA_HOST=

# Hosted access code (Tier 1.5).
ACCESS_CODE=
