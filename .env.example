# Copy to .env and fill in. Today nothing here is required: the mock
# provider runs with no keys at all.

# Which model backend to use: mock (today) or meta (from Oct 26).
MODEL_PROVIDER=mock

# Meta Model API, granted at hackathon kickoff on Oct 26.
META_MODEL_API_KEY=
# Only set if the official docs give a non-default base URL on Monday.
META_MODEL_API_BASE_URL=

# Optional model overrides. Leave blank to use each provider's default.
CHAT_MODEL=
IMAGE_MODEL=

# Inference partner credits (claim at kickoff, only if you use them):
# Baseten: $100 credits for Meta open-weights models
# Modal: $100 credits
# Fireworks: $25 credits
