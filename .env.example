# Copy to .env and fill in what you have. Every key is blank here; a blank
# value means "use the default" (AD-14). MODEL_PROVIDER=mock needs no keys.
# Containers and CI never hold key values.

# Product flags. Defaults: MODE=local|hosted (local; the Modal image sets
# hosted), MIN_CONTAINERS=0 (read when the hosted app is deployed), CACHE=on,
# SPEND_CAP_USD=60 under MODE=local and 20 under MODE=hosted (the running
# mode's allocation), DEMO_TIMESCALE=1, DEMO_TRICKSTER=live|record|scripted|authored
# (record is refused under MODE=hosted; scripted and authored refuse to start
# when their file is missing), DEMO_PROPOSALS_DIR=proposals (the folder holding
# recorded.json and authored.json; scripts/load_fixtures.py installs the
# four-lock recording under rooms/proposals/ for local play), DRY_RUN=on, REGEN_MAX=2,
# GUIDE=ollama|verbatim (ollama under MODE=local, verbatim under MODE=hosted,
# which refuses ollama). GUIDE=ollama needs Ollama at OLLAMA_HOST (default
# http://127.0.0.1:11434); past 5 s, unreachable or erroring, Rungs show as
# written. The offline suite sets GUIDE=verbatim. HINT_POLICY=chest|ladder
# (chest: hints open only from the treasure chest, HINT_CAP of them per Session,
# default 2; ladder: hints also open on idle time and wrong attempts).
MODE=
MIN_CONTAINERS=
CACHE=
SPEND_CAP_USD=
# Default 20: the Hosted allocation the local ledger export adds; must equal SPEND_CAP_USD in the hosted Modal Secret.
HOSTED_SPEND_CAP_USD=
DEMO_TIMESCALE=
DEMO_TRICKSTER=
DEMO_PROPOSALS_DIR=
DRY_RUN=
REGEN_MAX=
GUIDE=
HINT_POLICY=
HINT_CAP=

# Adapters: mock, meta (default) or openai_compatible (the Riddler and Trickster fallbacks);
# fal and ollama arrive with their stories. MODEL_PROVIDER is the default for each role.
MODEL_PROVIDER=
PROVIDER_ARCHITECT=
PROVIDER_RIDDLER=
PROVIDER_DRYRUN=
PROVIDER_STORYTELLER=
PROVIDER_TRICKSTER=
PROVIDER_IMAGE=

# Per-role model ids. Defaults: muse-spark-1.3 for the council roles,
# muse-image-1.0 for the image role. An openai_compatible role calls the id set
# here (PROVIDER_TRICKSTER=openai_compatible on Fireworks: the confirmed Fireworks
# id in MODEL_TRICKSTER); left blank, it calls Muse Spark Open on Baseten.
MODEL_ARCHITECT=
MODEL_RIDDLER=
MODEL_DRYRUN=
MODEL_STORYTELLER=
MODEL_TRICKSTER=
MODEL_IMAGE=

# Meta Model API (standard tier only). Base URL default: https://api.meta.ai/v1
MODEL_API_KEY=
META_MODEL_API_BASE_URL=

# OpenAI-compatible fallback hosts (Baseten, Fireworks).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# fal.ai (SAM 3D Objects, Tier 2).
FAL_KEY=

# Ollama Guide on the Mac. Default: the local server.
OLLAMA_HOST=

# Hosted access code (Tier 1.5).
ACCESS_CODE=
